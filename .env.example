NODE_ENV=development
PORT=5001
APP_NAME=FoodApp
CLIENT_URL=http://localhost:5173
API_URL=http://localhost:5001
DATABASE_URL=postgres://postgres:password@localhost:5432/foodapp
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# First admin (created by: npm run seed:admin)
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_PASSWORD=

# Email (SMTP). Leave SMTP_HOST empty in dev to print emails in the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="FoodApp <no-reply@yourdomain.com>"

# SMS (Termii - supports Ghana/Nigeria). Leave SMS_API_KEY empty in dev to print SMS in the console.
SMS_API_URL=https://api.ng.termii.com/api/sms/send
SMS_API_KEY=
SMS_SENDER_ID=FoodApp

# Payments (Paystack)
PAYSTACK_SECRET_KEY=
CURRENCY=GHS
